<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:y="http://www.yworks.com/xml/graphml" xmlns:yed="http://www.yworks.com/xml/yed/3">
  <key id="kind" for="node" attr.name="meshwork.kind" attr.type="string"/>
  <key id="name" for="node" attr.name="meshwork.name" attr.type="string"/>
  <key id="ns" for="graph" attr.name="meshwork.namespace" attr.type="string"/>
  <key id="type" for="node" attr.name="meshwork.type" attr.type="string"/>
  <key id="impl" for="node" attr.name="meshwork.implementation" attr.type="string"/>
  <key id="d0" for="node" yfiles.type="nodegraphics"/>
  <key id="d1" for="edge" yfiles.type="edgegraphics"/>
  <graph id="G" edgedefault="directed">
    <data key="ns">/logic/nand</data>
    <node id="group" yfiles.foldertype="group">
      <data key="d0"><y:ProxyAutoBoundsNode><y:Realizers active="0"><y:GroupNode><y:Geometry height="180.0" width="300.0" x="0.0" y="0.0"/><y:NodeLabel>Visual group only</y:NodeLabel></y:GroupNode></y:Realizers></y:ProxyAutoBoundsNode></data>
      <graph id="group:" edgedefault="directed">
        <node id="n0"><data key="kind">place</data><data key="name">A</data><data key="type">Bool</data><data key="d0"><y:ShapeNode><y:Geometry height="30.0" width="30.0" x="10.0" y="20.0"/><y:Fill color="#FFCC00" transparent="false"/><y:BorderStyle color="#000000" type="line" width="1.0"/><y:NodeLabel>A</y:NodeLabel><y:Shape type="ellipse"/></y:ShapeNode></data></node>
        <node id="n1"><data key="kind">place</data><data key="name">B</data><data key="type">Bool</data><data key="d0"><y:ShapeNode><y:Geometry height="30.0" width="30.0" x="10.0" y="80.0"/><y:NodeLabel>B</y:NodeLabel><y:Shape type="ellipse"/></y:ShapeNode></data></node>
        <node id="nested" yfiles.foldertype="group"><graph id="nested:" edgedefault="directed">
          <node id="n2"><data key="kind">transition</data><data key="name">nand</data><data key="impl">builtin.nand</data><data key="d0"><y:ShapeNode><y:Geometry height="20.0" width="40.0" x="90.0" y="50.0"/><y:NodeLabel>NAND</y:NodeLabel><y:Shape type="rectangle"/></y:ShapeNode></data></node>
        </graph></node>
      </graph>
    </node>
    <node id="n3"><data key="kind">place</data><data key="name">Q</data><data key="type">Bool</data><data key="d0"><y:ShapeNode><y:Geometry height="30.0" width="30.0" x="180.0" y="50.0"/><y:NodeLabel>Q</y:NodeLabel><y:Shape type="ellipse"/></y:ShapeNode></data></node>
    <node id="legend"><data key="d0"><y:ShapeNode><y:NodeLabel>Hand-authored NAND example</y:NodeLabel><y:Shape type="roundrectangle"/></y:ShapeNode></data></node>
    <edge id="e0" source="n0" target="n2"><data key="d1"><y:PolyLineEdge><y:Path sx="0.0" sy="0.0" tx="0.0" ty="0.0"><y:Point x="65.0" y="35.0"/></y:Path><y:LineStyle color="#000000" type="line" width="1.0"/><y:Arrows source="none" target="standard"/></y:PolyLineEdge></data></edge>
    <edge id="e1" source="n1" target="n2"/>
    <edge id="e2" source="n2" target="n3"/>
  </graph>
</graphml>
